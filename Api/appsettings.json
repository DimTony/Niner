{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=scheduler;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Worker": {
    "PollingIntervalMs": 1000,
    "LockTtlSeconds": 30,
    "HeartbeatIntervalSeconds": 10,
    "StaleLockThresholdMinutes": 2,
    "DlqAlertThreshold": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
